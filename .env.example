# Copy this file to .env and fill in your keys.

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Model that writes the script
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model that fact-checks the script. It searches the web, so Opus is worth the few extra cents.
ANTHROPIC_FACTCHECK_MODEL=claude-opus-5-5
# How many web searches the fact-checker may run per video (0 = check from memory only)
FACTCHECK_SEARCHES=8

# ElevenLabs (elevenlabs.io): API key + the ID of the voice you want
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Pexels stock footage (pexels.com/api), free
PEXELS_API_KEY=

# Optional background music (e.g. a track from the YouTube Audio Library)
MUSIC_PATH=
MUSIC_VOLUME=0.10

# Cross-fade between scenes, in seconds. 0 = hard cuts (faster render).
CROSSFADE=0.5

# YouTube OAuth client (Google Cloud Console > Credentials > OAuth client ID > Desktop app)
YT_CLIENT_SECRETS=client_secret.json
YT_TOKEN=youtube_token.json

# Optional: path to a bold .ttf font for thumbnails
THUMB_FONT=

# Unattended mode (--topics-file --yes): after this many failed runs, a topic moves to topics_failed.txt
MAX_ATTEMPTS=3
