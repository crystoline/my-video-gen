# Copy this file to .env and fill in your keys.

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Model that writes the script
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model that fact-checks the script. It searches the web, so Opus is worth the few extra cents.
ANTHROPIC_FACTCHECK_MODEL=claude-opus-5-5
# How many web searches the fact-checker may run per video (0 = check from memory only)
FACTCHECK_SEARCHES=8

# ElevenLabs (elevenlabs.io): API key + the ID of the voice you want
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# How new narration is generated (existing clips keep their sound until re-voiced).
# For a softer, calmer read try STABILITY 0.6-0.7, SIMILARITY 0.6-0.7, SPEAKER_BOOST false, SPEED 0.95.
VOICE_STABILITY=0.5
VOICE_SIMILARITY=0.75
VOICE_STYLE=0
VOICE_SPEAKER_BOOST=true
VOICE_SPEED=1.0
# Shaping applied to the narration in the final mix (free, no re-narration needed):
# natural = untouched, soft = tames harsh "s" sounds and the 3 kHz edge, warm = stronger soft
VOICE_TONE=soft

# Stock footage for Earth subjects. Set one or both; Pexels is tried first.
# Pexels (pexels.com/api) has paused issuing new keys as of late 2026; keep yours if you have one.
PEXELS_API_KEY=
# Pixabay (pixabay.com/api/docs): free, the key appears on the docs page once you log in.
PIXABAY_API_KEY=

# Optional background music (e.g. a track from the YouTube Audio Library), looped under the narration.
# A relative path is resolved next to pipeline.py. Leave empty for narration only; a path that
# doesn't exist stops the run at startup.
MUSIC_PATH=
# Music level relative to the voice, whatever the track's own loudness:
# 0.10 = 20 dB below the voice (typical documentary bed), 0.05 = 26 dB below, max 0.5.
MUSIC_VOLUME=0.10
# Dip the music about 6 dB while the narrator speaks
MUSIC_DUCKING=true

# Cross-fade between scenes, in seconds. 0 = hard cuts (faster render).
CROSSFADE=0.5

# YouTube OAuth client (Google Cloud Console > Credentials > OAuth client ID > Desktop app)
YT_CLIENT_SECRETS=client_secret.json
YT_TOKEN=youtube_token.json

# Optional: path to a bold .ttf font for thumbnails
THUMB_FONT=

# Unattended mode (--topics-file --yes): after this many failed runs, a topic moves to topics_failed.txt
MAX_ATTEMPTS=3
