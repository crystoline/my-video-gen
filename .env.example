# Copy this file to .env and fill in your keys.

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Model that writes the script
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model that fact-checks the script. It searches the web, so Opus is worth the few extra cents.
ANTHROPIC_FACTCHECK_MODEL=claude-opus-5-5
# How many web searches the fact-checker may run per video (0 = check from memory only)
FACTCHECK_SEARCHES=8

# ElevenLabs (elevenlabs.io): API key + the ID of the voice you want. If the key has restricted
# permissions, give it "User: Read" so the web interface can show how many characters you have left.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# How new narration is generated (existing clips keep their sound until re-voiced).
# For a softer, calmer read try STABILITY 0.6-0.7, SIMILARITY 0.6-0.7, SPEAKER_BOOST false, SPEED 0.95.
VOICE_STABILITY=0.5
VOICE_SIMILARITY=0.75
VOICE_STYLE=0
VOICE_SPEAKER_BOOST=true
VOICE_SPEED=1.0
# Shaping applied to the narration in the final mix (free, no re-narration needed):
# natural = untouched, soft = tames harsh "s" sounds and the 3 kHz edge, warm = stronger soft
VOICE_TONE=soft

# Stock footage for Earth subjects. Set one or both; Pexels is tried first.
# Pexels (pexels.com/api) has paused issuing new keys as of late 2026; keep yours if you have one.
PEXELS_API_KEY=
# Pixabay (pixabay.com/api/docs): free, the key appears on the docs page once you log in.
PIXABAY_API_KEY=
# Optional extra sources. Wikimedia Commons, Openverse and NASA need no key.
# Unsplash (unsplash.com/developers): free "Access Key"; photos are credited and their use reported to Unsplash.
UNSPLASH_ACCESS_KEY=
# Smithsonian Open Access (CC0 museum images): free key from api.data.gov/signup
SMITHSONIAN_API_KEY=
# Which providers are used and in which order (set in the web UI's Settings). Empty = all of them.
VISUAL_PROVIDERS=
# Also use CC BY-SA (share-alike) files from Wikimedia Commons and Openverse
ALLOW_SHARE_ALIKE=false
# Claude as picture editor: it looks at up to 12 small previews and ranks the results that fit the narration.
# off = never by itself; rank = in the web UI's picker; auto = also when visuals are fetched automatically
AUTO_PICK=off
# Model for that (empty = ANTHROPIC_MODEL)
ANTHROPIC_VISION_MODEL=

# AI-generated visuals through fal.ai (fal.ai/dashboard/keys). Billed by fal.ai per image or clip.
FAL_KEY=
# off, images, or images_and_video (also set in the web UI's Settings)
AI_VISUALS=off
AI_IMAGE_MODEL=fal-ai/flux/dev
AI_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/text-to-video
# Prices shown before generating (USD); update them if you change models or fal.ai changes its prices
AI_IMAGE_COST=0.025
AI_VIDEO_COST=0.35

# Optional background music (e.g. tracks from the YouTube Audio Library), looped under the narration.
# Either one track for every video (music/my-track.mp3), or a folder of tracks (music): each new video
# then gets the track used least so far and keeps it. A video can also pick its own track in the web
# interface. A relative path is resolved next to pipeline.py. Leave empty for narration only; a path
# that doesn't exist stops the run at startup.
MUSIC_PATH=
# Music level relative to the voice, whatever the track's own loudness:
# 0.10 = 20 dB below the voice (typical documentary bed), 0.05 = 26 dB below, max 0.5.
MUSIC_VOLUME=0.10
# Dip the music about 6 dB while the narrator speaks
MUSIC_DUCKING=true

# Cross-fade between scenes, in seconds. 0 = hard cuts.
CROSSFADE=0.5
# How many scenes render at the same time. Empty = automatic (a quarter of the CPU cores, 1 to 4).
RENDER_JOBS=
# Extra shots for long scenes: a scene gets one more visual for about every this many seconds (max 3 per scene).
# 0 = one visual per scene. Extra visuals come from the same search and are fetched automatically.
SHOT_SECONDS=0

# YouTube OAuth client (Google Cloud Console > Credentials > OAuth client ID > Desktop app).
# Enable the YouTube Data API v3, and the YouTube Analytics API for watch-time statistics.
YT_CLIENT_SECRETS=client_secret.json
YT_TOKEN=youtube_token.json

# Optional: path to a bold .ttf font for thumbnails
THUMB_FONT=

# Unattended mode (--topics-file --yes): after this many failed runs, a topic moves to topics_failed.txt
MAX_ATTEMPTS=3
